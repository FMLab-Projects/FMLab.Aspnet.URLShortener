# Copy this file to the path the deploy-homelab workflow reads secrets from
# (see .github/workflows/deploy-homelab.yml -> vars.HOMELAB_ENV_FILE, default
# /home/fagner/homelab/applications/url-shortener/.env) and fill in real values.
# This example file itself is never read by the deploy.

# Public hostname Traefik should route to this service.
APP_HOSTNAME=shortener.fmlab.com.br

# API key required by the API's auth middleware.
API_KEY=change_this_to_a_secure_key

# Postgres — already running in the homelab and shared across apps.
# DB_SERVER is the container name/alias reachable on homelab-network.
DB_SERVER=postgres
DB_PORT=5432
DB_NAME=fmlab_shortener
DB_USER=change_this_to_a_secure_user
DB_PASSWORD=change_this_to_a_secure_password

# Redis — already running in the homelab and shared across apps.
# Requires auth (NOAUTH), so REDIS_PASSWORD must match the shared instance's requirepass.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_the_shared_redis_password

# Optional: override if the shared external Docker network isn't named "homelab-network".
# HOMELAB_NETWORK=homelab-network
